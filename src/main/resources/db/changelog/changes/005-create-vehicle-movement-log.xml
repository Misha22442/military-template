<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-create-vehicle-movement-log" author="military-system">
        <comment>Creating vehicle movement log table for tracking all vehicle operations</comment>
        
        <createTable tableName="vehicle_movement_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            
            <column name="vehicle_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            
            <column name="driver_id" type="BIGINT"/>
            
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            
            <column name="description" type="VARCHAR(500)"/>
            
            <column name="destination" type="VARCHAR(200)"/>
            
            <column name="mileage_at_operation" type="INTEGER"/>
            
            <column name="fuel_level" type="DECIMAL(10,2)"/>
            
            <column name="maintenance_type" type="VARCHAR(100)"/>
            
            <column name="notes" type="VARCHAR(500)"/>
            
            <column name="performed_by" type="VARCHAR(100)"/>
            
            <column name="performed_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addForeignKeyConstraint 
            baseTableName="vehicle_movement_logs"
            baseColumnNames="vehicle_id"
            referencedTableName="vehicles"
            referencedColumnNames="id"
            constraintName="fk_movement_logs_vehicle"
            onDelete="RESTRICT"/>
        
        <addForeignKeyConstraint 
            baseTableName="vehicle_movement_logs"
            baseColumnNames="driver_id"
            referencedTableName="drivers"
            referencedColumnNames="id"
            constraintName="fk_movement_logs_driver"
            onDelete="SET NULL"/>
        
        <rollback>
            <dropForeignKeyConstraint 
                baseTableName="vehicle_movement_logs"
                constraintName="fk_movement_logs_vehicle"/>
            <dropForeignKeyConstraint 
                baseTableName="vehicle_movement_logs"
                constraintName="fk_movement_logs_driver"/>
            <dropTable tableName="vehicle_movement_logs"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
